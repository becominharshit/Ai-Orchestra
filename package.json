{
  "name": "play-zenith",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zenith School of AI stall experiences for KRMU Ideas 4.0 (play.zenithschool.ai).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node core/server/index.js",
    "dev": "node --watch-path=core/server --watch-path=experiences core/server/index.js",
    "mock": "CLAUDE_MOCK=1 node core/server/index.js",
    "offline": "DEMO_MODE=1 OFFLINE=1 node core/server/index.js",
    "stats": "node core/server/stats.js",
    "test": "node test/core/run-all.mjs",
    "test:unit": "PZ_NO_DOTENV=1 node --test --test-concurrency=1 test/core/*.test.js",
    "test:e2e": "PZ_NO_DOTENV=1 playwright test --config test/core/playwright.config.js",
    "loadtest": "node test/core/load.mjs",
    "shots": "node test/core/shots.mjs",
    "test:core": "npm run test:unit && npm run test:e2e",
    "asli:check": "cd experiences/asli && node scripts/check.mjs",
    "asli:add": "cd experiences/asli && node scripts/add.mjs",
    "asli:list": "cd experiences/asli && node scripts/add.mjs --list",
    "asli:approve": "cd experiences/asli && node scripts/add.mjs --approve",
    "asli:voices": "cd experiences/asli && node scripts/make-voices.mjs",
    "setup": "node core/tools/setup.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
