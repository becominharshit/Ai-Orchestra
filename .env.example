# Copy to .env for local use (git-ignored). Never commit real values.

# Server
PORT=8790                      # container uses 8080
PUBLIC_URL=https://play.zenithschool.ai   # base for TV QR codes; at the stall offline use http://<laptop-ip>:8790
# NODE_ENV=production

# Claude (via core/server/claude.js only). Set the key with ops/set-claude-key.mjs, never by hand in chat.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_MOCK=0                  # 1 = canned schema-shaped answers, no key needed
CLAUDE_MOCK_LATENCY_MS=900     # fake latency in mock mode
CLAUDE_TIMEOUT_MS=25000
# the live AI crisis check on visitor text gets 3 s, then the rules decide
CARE_LIVE_TIMEOUT_MS=3000
# reward tokens only for big-screen turns of at least this many seconds
STAGE_MIN_TURN_S=20
DEMO_MODE=0                    # 1 = fixtures only
OFFLINE=0                      # 1 = DEMO_MODE + block every outbound request (npm run offline)
SPEND_CAP_USD=300              # hard cap; after it every call answers from fixtures

# Limits (generous per IP: mobile CGNAT shares IPs)
MAX_IN_FLIGHT=30               # global concurrent Claude-backed requests, the rest queue
SESSION_LIMIT=40               # Claude-backed calls per anonymous session per window (staff phones exempt via /admin/staff)
IP_LIMIT=400                   # per IP per window
LIMIT_WINDOW_MS=600000

# Analytics (counts only)
DATA_DIR=./data
SNAPSHOT_MS=30000
ADMIN_KEY=                     # /admin?key=... is off while empty
BUCKET_NAME=                   # play-zenith-data on Lightsail; empty = local file only
BUCKET_REGION=ap-south-1
BUCKET_KEY_ID=
BUCKET_KEY_SECRET=

# Public hero line (hub, TV About card, share cards). One setting, no code change.
PUBLIC_HERO_LINE=Zenith first-years ne AI agents ke saath banaye
PUBLIC_HERO_LINE_HI=Zenith first-years x AI agents

# Public text rule (CONTRACT 13.2, CHECK_build 13): ON by default. 0 only on a local laptop while migrating.
PUBLIC_TEXT_STRICT=1

# Stage mode (CONTRACT 12): all on by default; set one to 0 to switch that feature off
STAGE_LOOP=1                   # idle loop on counter TVs (QR, counters, leaderboard, anchor, about)
STAGE_QUEUE=1                  # "Big screen pe khelo" queue
STAGE_ANCHOR=1                 # guest star / record card
STAGE_REWARD=1                 # reward token after a big-screen turn

# Squad Reel worker (TASK-04)
REEL_WORKER_URL=               # e.g. http://127.0.0.1:8795 locally; /status.json reports reelWorker when set
REEL_SHARED_SECRET=            # shared secret between play-web and the reel worker (set by ops/set-secret.mjs)
REEL_TTL_HOURS=48              # reels are deleted after this many hours (privacy rule: max 48)

# CHANGE-02 (TASK-20): new experiences stay off until their go/no-go (counter 2 = Startup Studio, counter 4 = Agent Builder)
STARTUP_STUDIO=0
AGENT_BUILDER=0
# per-experience daily budgets in USD (IST day); the global SPEND_CAP_USD still applies.
# Unset = no per-experience budget; 0 = banked answers only (no model calls for that experience).
# BUDGET_USD_STARTUP=40
# BUDGET_USD_AGENT=30
