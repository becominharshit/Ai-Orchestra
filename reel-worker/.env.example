# play-reel worker settings (copy to reel-worker/.env for local use is NOT needed: pass them as env vars).
# Lightsail container service play-reel sets these as container settings. Never commit real values.

PORT=8080                     # container port (local dev: 8813)
NODE_ENV=production           # production refuses every request except /healthz when REEL_SHARED_SECRET is empty
REEL_SHARED_SECRET=           # same value as on play-web; play-web sends it as header x-reel-secret
REEL_TTL_HOURS=48             # finished reels are deleted after this many hours
REEL_CONCURRENCY=1            # renders at the same time (1 per vCPU is a good start)
REEL_QUEUE_MAX=30             # queued jobs before the phone gets the "busy" queue screen
REEL_MAX_CLIP_MB=80           # upload limit per shot
REEL_MAX_CLIP_S=30            # longest accepted shot (seconds)
REEL_MIN_CLIP_S=2             # shortest accepted shot (seconds; the copy says "2 second")
REEL_INPUT_TTL_MIN=10         # uploaded clips that never got rendered are deleted after this many minutes
# REEL_PRESET=veryfast        # x264 preset (faster = quicker render, slightly bigger file)
# REEL_THREADS=               # x264 threads (empty = auto)
# REEL_STORAGE_DIR=./storage  # where clips, reels and the asset cache live
# FFMPEG_PATH=/usr/bin/ffmpeg # set in the Dockerfile; locally ffmpeg-static is used

# play-web side (core owns the root .env.example; add these there):
# REEL_WORKER_URL=https://<play-reel public endpoint>   empty locally = embedded worker (not in production)
# REEL_SHARED_SECRET=<same as above>
# REEL_EMBED=0                 turn off the embedded local worker
