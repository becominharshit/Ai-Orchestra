{
  "name": "play-reel-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Squad Reel Studio render worker (Node + ffmpeg). Lightsail container service play-reel.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "PORT=8813 node src/server.js",
    "test": "node --test --test-concurrency=1 ../test/reel/*.test.js",
    "load": "node ../test/reel/load.mjs",
    "fonts": "python3 fonts/make-fonts.py"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ffmpeg-static": "5.3.0"
  }
}
